# Copy to .env for local development (without Docker): cp .env.example .env
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL=postgres://shop:shop@localhost:5432/shop
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me
COOKIE_SECURE=false

# Demo accounts created by the seed script
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=Admin@123

# Email (leave SMTP_HOST empty to just print emails in the server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TechParts <no-reply@techparts.local>

# Development only: show the "set password" link on the page after registering
DEV_SHOW_LINKS=true
