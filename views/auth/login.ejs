<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card auth-card"><div class="card-body p-4">
      <h1 class="h4 mb-3">Đăng nhập</h1>
      <%- include('../partials/errors') %>
      <form method="post" action="/login" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-3">
          <label class="form-label" for="email">Email</label>
          <input class="form-control" id="email" name="email" type="email" required autocomplete="email" value="<%= values.email || '' %>">
        </div>
        <div class="mb-3">
          <label class="form-label" for="password">Mật khẩu</label>
          <input class="form-control" id="password" name="password" type="password" required autocomplete="current-password">
        </div>
        <button class="btn btn-accent w-100" type="submit">Đăng nhập</button>
      </form>
      <p class="small text-muted mt-3 mb-0">Chưa có tài khoản? <a href="/register">Đăng ký</a></p>
    </div></div>
  </div>
</div>
<%- include('../partials/footer') %>
