<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card auth-card"><div class="card-body p-4">
      <% if (invalid) { %>
        <h1 class="h4">Liên kết không hợp lệ</h1>
        <p class="text-muted">Liên kết đặt mật khẩu đã hết hạn hoặc đã được sử dụng.</p>
        <a href="/register" class="btn btn-accent">Nhận liên kết mới</a>
      <% } else { %>
        <h1 class="h4 mb-1">Đặt mật khẩu</h1>
        <p class="text-muted small mb-3">Tài khoản: <strong><%= email %></strong></p>
        <%- include('../partials/errors') %>
        <form method="post" action="/set-password/<%= token %>" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label class="form-label" for="password">Mật khẩu mới</label>
            <input class="form-control" id="password" name="password" type="password" required minlength="8" maxlength="72" autocomplete="new-password">
            <div class="form-text">Tối thiểu 8 ký tự, gồm cả chữ và số.</div>
          </div>
          <div class="mb-3">
            <label class="form-label" for="confirm">Nhập lại mật khẩu</label>
            <input class="form-control" id="confirm" name="confirm" type="password" required autocomplete="new-password">
          </div>
          <button class="btn btn-accent w-100" type="submit">Lưu mật khẩu</button>
        </form>
      <% } %>
    </div></div>
  </div>
</div>
<%- include('../partials/footer') %>
